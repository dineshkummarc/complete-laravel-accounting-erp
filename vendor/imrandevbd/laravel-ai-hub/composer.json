{
    "name": "imrandevbd/laravel-ai-hub",
    "description": "Premium multi-provider Laravel AI SDK — dynamic model routing, Gemini 4 Argon, GPT-6 Luna, Claude 5.5, 13 providers, AIHub::fake() testing engine, multi-turn chat sessions, SSE streaming, structured JSON schemas, Studio playground, failover, and cost tracking.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "laravel-ai",
        "ai",
        "llm",
        "model-routing",
        "gemini",
        "gemini-argon",
        "gemini-4-argon",
        "openai",
        "gpt-6",
        "gpt-luna",
        "gpt-6-luna",
        "claude",
        "anthropic",
        "grok",
        "xai",
        "deepseek",
        "deepseek-v4",
        "mistral",
        "groq",
        "ollama",
        "openrouter",
        "azure-openai",
        "together-ai",
        "fireworks-ai",
        "perplexity",
        "ai-studio",
        "failover",
        "cost-tracking",
        "observability",
        "chat-sessions",
        "streaming",
        "embeddings"
    ],
    "authors": [
        {
            "name": "Imran Dev BD",
            "email": "me@imrandev.bd",
            "homepage": "https://imrandev.bd",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/imranbru99/laravel-ai-hub",
    "support": {
        "issues": "https://github.com/imranbru99/laravel-ai-hub/issues",
        "source": "https://github.com/imranbru99/laravel-ai-hub"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "ImranDevBd\\AiHub\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ImranDevBd\\AiHub\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "filament/filament": "Required only if you use the AI Hub sidebar item or AiHubDashboardWidget"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ImranDevBd\\AiHub\\AiHubServiceProvider"
            ],
            "aliases": {
                "AIHub": "ImranDevBd\\AiHub\\Facades\\AIHub"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
