{
    "name": "imrandevbd/laravel-universal-slug",
    "description": "Universal, multilingual, and Unicode-safe slug generator for Laravel with Eloquent unique slug support for any language and script (Bengali, Arabic, Hindi, Chinese, Russian, European, etc.).",
    "keywords": [
        "laravel",
        "slug",
        "multilingual",
        "unicode",
        "bengali",
        "arabic",
        "hindi",
        "chinese",
        "universal-slug",
        "eloquent",
        "seo-url"
    ],
    "homepage": "https://github.com/imrandevbd/laravel-universal-slug",
    "license": "MIT",
    "authors": [
        {
            "name": "Imran Dev BD",
            "email": "me@imrandev.bd",
            "homepage": "https://imrandev.bd",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4|^8.5",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0",
        "laravel/pint": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "ImranDev\\UniversalSlug\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ImranDev\\UniversalSlug\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ImranDev\\UniversalSlug\\UniversalSlugServiceProvider"
            ],
            "aliases": {
                "UniversalSlug": "ImranDev\\UniversalSlug\\Facades\\UniversalSlug"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint --test",
        "fix": "vendor/bin/pint"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
