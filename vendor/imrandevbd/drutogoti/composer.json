{
    "name": "imrandevbd/drutogoti",
    "description": "Auto-detect, visualize, and fix performance bottlenecks in Laravel.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Imran Dev BD",
            "email": "me@imrandev.bd",
            "homepage": "https://imrandev.bd",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/log": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/cache": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/phpstan": "^1.10",
        "laravel/pint": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "Drutogoti\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Drutogoti\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Drutogoti\\DrutogotiServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
